<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Build Pad into its own output dir so the tests also run while PAD holds bin\... -->
    <PadOutDir>$(MSBuildThisFileDirectory)pad-bin\</PadOutDir>
    <PadDll>$(PadOutDir)pack-agent-for DSH.dll</PadDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Pad is a WPF WinExe; a ProjectReference makes MSBuild run its XAML compile in a
    temporary project that loses the generated named fields. Build it first (to a
    separate output dir, so a running PAD does not lock the build output) and link
    the resulting assembly instead.
  -->
  <ItemGroup>
    <Reference Include="pack-agent-for DSH">
      <HintPath>$(PadDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildPadForTests" BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="..\pad\Pad.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);OutputPath=$(PadOutDir)" />
  </Target>

</Project>
