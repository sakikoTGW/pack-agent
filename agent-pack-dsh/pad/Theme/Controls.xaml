            <Border Background="{StaticResource BgCard}" CornerRadius="{StaticResource RadCtl}"
                    BorderThickness="1" BorderBrush="{StaticResource LineBorder}" />
            <Border x:Name="hot" Background="{StaticResource DangerWash}"
                    CornerRadius="{StaticResource RadCtl}" BorderThickness="1"
                    BorderBrush="{StaticResource Danger}" Opacity="0" />
            <Border x:Name="ring" CornerRadius="8" Margin="-2" BorderThickness="2"
                    BorderBrush="{StaticResource Focus}" Opacity="0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}">
              <v:Ico x:Name="btnIco" Height="12" Margin="0,0,6,0"
                     Foreground="{TemplateBinding Foreground}"
                     Glyph="{Binding Path=(v:Ico.Of), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.Children[1].(TranslateTransform.Y)"
                                     To="-1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.Children[1].(TranslateTransform.Y)"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.Children[0].(ScaleTransform.ScaleX)"
                                     To="0.985" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.Children[0].(ScaleTransform.ScaleY)"
                                     To="0.965" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.Children[0].(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.Children[0].(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="root" Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(v:Ico.Of), RelativeSource={RelativeSource TemplatedParent}}"
                         Value="{x:Null}">
              <Setter TargetName="btnIco" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="btnIco" Property="Margin" Value="0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="{StaticResource FsSmall}" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="root" Background="Transparent">
            <Border x:Name="hot" Background="{StaticResource AccentWash}"
                    CornerRadius="{StaticResource RadCtl}" Opacity="0" />
            <Border x:Name="ring" CornerRadius="7" BorderThickness="2"
                    BorderBrush="{StaticResource Focus}" Opacity="0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}">
              <v:Ico Height="12" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}"
                     Glyph="{Binding Path=(v:Ico.Of), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="root" Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ tooltip ============================ -->

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource ChromeInk}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
    <Setter Property="FontSize" Value="{StaticResource FsSmall}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="VerticalOffset" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource BgChrome}" CornerRadius="{StaticResource RadCtl}"
                  Padding="9,5,9,6">
            <Border.RenderTransform>
              <TranslateTransform />
            </Border.RenderTransform>
            <Border.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                     Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     From="-4" To="0" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Border.Triggers>
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ toast ============================ -->

  <Style x:Key="Toast" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgChrome}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadRow}" />
    <Setter Property="Padding" Value="13,10,15,11" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#FF19222A" />
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
