<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Pad.Views">

  <!-- Thin scrollbars. WPF defaults are 17px of chrome the fixed 1000x620 canvas
       cannot spare. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent" Margin="2,0">
            <Border x:Name="t" Background="{StaticResource InkDisabled}" CornerRadius="3" Opacity="0.7" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Background" Value="{StaticResource AccentLight}" />
              <Setter TargetName="t" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="t" Property="Background" Value="{StaticResource Accent}" />
              <Setter TargetName="t" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="9" />
        <Setter Property="MinHeight" Value="9" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Tag is the placeholder: it shows while the box is empty and never covers input. -->
  <Style TargetType="TextBox">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
    <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border Background="{StaticResource BgCard}" CornerRadius="{StaticResource RadCtl}"
                    BorderThickness="1" BorderBrush="{StaticResource LineBorder}" />
            <Border x:Name="hot" CornerRadius="{StaticResource RadCtl}" BorderThickness="1"
                    BorderBrush="{StaticResource AccentLight}" Opacity="0" />
            <Border x:Name="ring" CornerRadius="{StaticResource RadCtl}" BorderThickness="1.6"
                    BorderBrush="{StaticResource Focus}" Opacity="0" />
            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Opacity="0"
                       Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                       FontSize="{TemplateBinding FontSize}" />
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="hot" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
              <Setter TargetName="hint" Property="Opacity" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Read-only mono transcript: subprocess output, never an editable field. -->
  <Style x:Key="LogBox" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Foreground" Value="{StaticResource ChromeInk}" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentLight}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentPress}" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="{StaticResource FsSmall}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{StaticResource BgChrome}" CornerRadius="{StaticResource RadRow}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Foreground" Value="{StaticResource TextBody}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
    <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid>
            <Border x:Name="hot" Background="{StaticResource AccentWash}" Opacity="0" />
            <Border x:Name="rail" Width="2" HorizontalAlignment="Left"
                    Background="{StaticResource Accent}" Opacity="0" />
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="hot" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="hot" Property="Opacity" Value="1" />
              <Setter TargetName="rail" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
    <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border Background="{StaticResource BgCard}" CornerRadius="{StaticResource RadCtl}"
                            BorderThickness="1" BorderBrush="{StaticResource LineBorder}" />
                    <Border x:Name="hot" CornerRadius="{StaticResource RadCtl}" BorderThickness="1"
                            BorderBrush="{StaticResource AccentLight}" Opacity="0" />
                    <Border x:Name="open" CornerRadius="{StaticResource RadCtl}" BorderThickness="1.6"
                            BorderBrush="{StaticResource Accent}" Opacity="0" />
                    <Path x:Name="chev" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,11,0" Data="M 0 0 L 4.5 4.5 L 9 0"
                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform>
                        <RotateTransform />
                      </Path.RenderTransform>
                    </Path>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="hot" Property="Opacity" Value="1" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="open" Property="Opacity" Value="1" />
                      <Trigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="chev"
                                             Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                             To="180" Duration="{StaticResource DShort}"
                                             EasingFunction="{StaticResource EaseOut}" />
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.EnterActions>
                      <Trigger.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="chev"
                                             Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                             To="0" Duration="{StaticResource DShort}"
                                             EasingFunction="{StaticResource EaseOut}" />
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="box" Margin="10,0,28,0" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <TextBox x:Name="PART_EditableTextBox" Margin="1" Padding="9,0" BorderThickness="0"
                     Background="Transparent" Visibility="Collapsed"
                     VerticalContentAlignment="Center" Foreground="{StaticResource TextPrimary}"
                     FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FsBody}"
                     CaretBrush="{StaticResource Accent}" />
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
              <Border x:Name="drop" Background="{StaticResource BgCard}"
                      CornerRadius="{StaticResource RadRow}"
                      Margin="0,4,0,0" BorderThickness="1" BorderBrush="{StaticResource LineBorder}"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                      ClipToBounds="True">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.18"
                                    Color="#FF19222A" />
                </Border.Effect>
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Margin="0,4" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="box" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="drop"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     From="-5" To="0" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Selection is an outline plus a rail, never a fill: the row's own status colours
       have to stay readable while it is selected. -->
  <Style x:Key="RowItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid x:Name="root">
            <Grid.RenderTransform>
              <TranslateTransform />
            </Grid.RenderTransform>
            <Border Background="{StaticResource BgCard}" CornerRadius="{StaticResource RadRow}"
                    BorderThickness="1" BorderBrush="{StaticResource LineDivider}" />
            <Border x:Name="hot" Background="{StaticResource AccentWash}"
                    CornerRadius="{StaticResource RadRow}" BorderThickness="1"
                    BorderBrush="{StaticResource AccentLight}" Opacity="0" />
            <Border x:Name="sel" CornerRadius="{StaticResource RadRow}" BorderThickness="1.4"
                    BorderBrush="{StaticResource Accent}" Opacity="0" />
            <Border x:Name="rail" Width="3" HorizontalAlignment="Left" Margin="0,7"
                    CornerRadius="2" Background="{StaticResource Accent}"
                    RenderTransformOrigin="0.5,0.5" Opacity="0">
              <Border.RenderTransform>
                <ScaleTransform ScaleY="0.3" />
              </Border.RenderTransform>
            </Border>
            <ContentPresenter Margin="12,9,12,10" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                     To="2" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="sel" Property="Opacity" Value="1" />
              <Setter TargetName="rail" Property="Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="rail"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- Compact tick for PCL-style list multi-select. Not the launch Switch. -->
  <Style x:Key="Tick" TargetType="CheckBox">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="18" Height="18" Background="Transparent">
            <Border x:Name="bd" Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource LineBorder}" BorderThickness="1"
                    CornerRadius="3" />
            <Border x:Name="ring" CornerRadius="4" Margin="-2" BorderThickness="1.6"
                    BorderBrush="{StaticResource Focus}" Opacity="0" />
            <v:Ico x:Name="mark" Glyph="{StaticResource I.Check}" Height="11" Opacity="0"
                   Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentWash}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter TargetName="mark" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ toggle switch ============================ -->

  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextBody}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
    <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid x:Name="root" Width="38" Height="22" VerticalAlignment="Center">
              <Border Background="{StaticResource InkDisabled}" CornerRadius="11" />
              <Border x:Name="on" Background="{StaticResource Accent}" CornerRadius="11" Opacity="0" />
              <Border x:Name="ring" CornerRadius="12" Margin="-2" BorderThickness="2"
                      BorderBrush="{StaticResource Focus}" Opacity="0" />
              <Border x:Name="knob" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Left"
                      Margin="3,0,0,0" Background="{StaticResource BgCard}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.28"
                                    Color="#FF19222A" />
                </Border.Effect>
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="knob"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                     To="16" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="knob"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                     To="0" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="root" Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ radio card ============================ -->

  <Style x:Key="RadioCard" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="root">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="slide" />
            </Grid.RenderTransform>
            <Border Background="{StaticResource BgCard}" CornerRadius="{StaticResource RadRow}"
                    BorderThickness="1" BorderBrush="{StaticResource LineBorder}" />
            <Border x:Name="hot" Background="{StaticResource AccentWash}"
                    CornerRadius="{StaticResource RadRow}" Opacity="0" />
            <Border x:Name="sel" CornerRadius="{StaticResource RadRow}" BorderThickness="1.5"
                    BorderBrush="{StaticResource Accent}" Opacity="0" />
            <Border x:Name="ring" CornerRadius="8" Margin="-2" BorderThickness="2"
                    BorderBrush="{StaticResource Focus}" Opacity="0" />
            <Grid Margin="13,11,14,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,11,0">
                <Ellipse Stroke="{StaticResource InkDisabled}" StrokeThickness="1.5" />
                <Ellipse x:Name="dotRing" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Opacity="0" />
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Accent}"
                         RenderTransformOrigin="0.5,0.5" Opacity="0">
                  <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="0.2" ScaleY="0.2" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                     To="2" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="root"
                                     Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                     To="0" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="sel" Property="Opacity" Value="1" />
              <Setter TargetName="dotRing" Property="Opacity" Value="1" />
              <Setter TargetName="dot" Property="Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="dot"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="dot"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource DShort}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="dot"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                     To="0.2" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="dot"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="0.2" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ segmented control ============================ -->

  <Style x:Key="SegTab" TargetType="RadioButton">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
    <Setter Property="FontSize" Value="{StaticResource FsSmall}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="sel" Background="{StaticResource BgCard}" CornerRadius="{StaticResource RadCtl}"
                    Margin="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.12"
                                  Color="#FF19222A" />
              </Border.Effect>
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
              </Border.RenderTransform>
            </Border>
            <Border x:Name="ring" CornerRadius="{StaticResource RadCtl}" Margin="1" BorderThickness="2"
                    BorderBrush="{StaticResource Focus}" Opacity="0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}">
              <v:Ico Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                     Foreground="{TemplateBinding Foreground}"
                     Glyph="{Binding Path=(v:Ico.Of), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="sel" Property="Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sel"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                     To="1" Duration="{StaticResource DMed}"
                                     EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="sel"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="1" Duration="{StaticResource DMed}"
                                     EasingFunction="{StaticResource EaseOut}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="sel"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                     To="0.86" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                    <DoubleAnimation Storyboard.TargetName="sel"
                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                     To="0.86" Duration="{StaticResource DMicro}"
                                     EasingFunction="{StaticResource EaseIn}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegGroup" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgSubtle}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource LineDivider}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="PadSlider" TargetType="Slider">
    <Setter Property="Height" Value="22" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="{StaticResource LineDivider}"
                    VerticalAlignment="Center" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"
                              VerticalAlignment="Center" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{StaticResource BgCard}" Stroke="{StaticResource Accent}"
                               StrokeThickness="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
