<Window x:Class="Pad.Views.PackExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="导出整合包" Width="700" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid>
    <Border Background="#8C0B1420" />
    <Border Width="660" MaxHeight="660" Background="{StaticResource BgCard}" CornerRadius="20"
            VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.30" Color="#FF0B1420" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,22,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <v:PluginMark Width="40" Height="40" Size="40" Spec="pack" Kind="整合包"
                        VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="导出整合包" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="HeaderSub" Style="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
          <Border Grid.Column="2" Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource LineBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="7,1,7,2" VerticalAlignment="Center">
            <TextBlock Text="v3" FontSize="{StaticResource FsMicro}"
                       Foreground="{StaticResource TextSecondary}" />
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,22,6">
          <StackPanel>
            <!-- 基本信息 -->
            <Border Style="{StaticResource Slab}" Padding="20,12,20,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Style="{StaticResource CardHead}" Text="基本信息" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Label}" Text="名称" VerticalAlignment="Center" />
                  <TextBox x:Name="NameBox" Grid.Column="1" Width="360" HorizontalAlignment="Left"
                           Height="28" Padding="6,3" VerticalContentAlignment="Center" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Label}" Text="版本" VerticalAlignment="Center" />
                  <TextBox x:Name="VersionBox" Grid.Column="1" Width="110" Height="28" Padding="6,3"
                           VerticalContentAlignment="Center" />
                  <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="作者" Margin="20,0,10,0"
                             VerticalAlignment="Center" />
                  <TextBox x:Name="AuthorBox" Grid.Column="3" Width="180" HorizontalAlignment="Left"
                           Height="28" Padding="6,3" VerticalContentAlignment="Center" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Label}" Text="说明" VerticalAlignment="Top"
                             Margin="0,6,0,0" />
                  <TextBox x:Name="DescBox" Grid.Column="1" Height="52" Padding="6,5" TextWrapping="Wrap"
                           AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- 带什么 -->
            <Border Style="{StaticResource Slab}" Padding="20,12,20,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Style="{StaticResource CardHead}" Text="带什么" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="DataBox" Content="附带头数据 .agent-pack" IsChecked="True"
                            Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}" />
                  <TextBlock x:Name="DataHint" Grid.Column="1" Style="{StaticResource Muted}"
                             VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="WorkspaceBox" Content="工作区模板" IsChecked="False"
                            Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}"
                            VerticalAlignment="Center" Checked="Workspace_Changed" Unchecked="Workspace_Changed" />
                  <Button Grid.Column="1" Style="{StaticResource Btn}" Content="浏览…" Height="28"
                          MinWidth="80" Margin="12,0,0,0" Click="BrowseWorkspace_Click" />
                  <TextBlock x:Name="WorkspacePath" Grid.Column="2" Style="{StaticResource Muted}"
                             Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <CheckBox x:Name="BundledBox" Content="随包带插件包体（离线可用）" IsChecked="False"
                          Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}"
                          Margin="0,12,0,0" Checked="Bundled_Changed" Unchecked="Bundled_Changed" />
                <StackPanel x:Name="BundledPanel" Margin="22,8,0,0" Visibility="Collapsed">
                  <ItemsControl x:Name="BundleList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                     FontSize="{StaticResource FsBody}" Margin="8,0,0,0"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Muted}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="BundledTotal" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                             Margin="0,2,0,0" />
                </StackPanel>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Label}" Text="内核" VerticalAlignment="Center" />
                  <RadioButton x:Name="PinRadio" Grid.Column="1" GroupName="kernel" Content="钉版本（包小）"
                               IsChecked="True" Foreground="{StaticResource TextPrimary}"
                               FontSize="{StaticResource FsBody}" VerticalAlignment="Center" />
                  <RadioButton x:Name="InheritRadio" Grid.Column="2" GroupName="kernel" Content="不钉（用目标机版本）"
                               Foreground="{StaticResource TextMuted}" FontSize="{StaticResource FsBody}"
                               Margin="18,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- 导出到 -->
            <Border Style="{StaticResource Slab}" Padding="20,12,20,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardHead}" Text="导出到" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="OutBox" Height="28" Padding="6,3" FontFamily="{StaticResource FontMono}"
                           FontSize="{StaticResource FsSmall}" VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Style="{StaticResource Btn}" Content="浏览" Height="28"
                          MinWidth="80" Margin="10,0,0,0" Click="BrowseOut_Click" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerText}"
                       FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="2,8,0,0"
                       Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineDivider}"
                Padding="24,13,22,14">
          <Grid>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource Btn}" Content="取消" Height="35" MinWidth="110"
                      Margin="0,0,10,0" Click="Cancel_Click" />
              <Button x:Name="ExportBtn" Style="{StaticResource BtnPrimary}" Content="导出"
                      Height="35" MinWidth="130" Click="Export_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
