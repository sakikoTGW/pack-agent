<Window x:Class="Pad.Views.PackImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="导入整合包" Width="760" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid>
    <Border Background="#8C0B1420" />
    <Border Width="720" MaxHeight="580" Background="{StaticResource BgCard}" CornerRadius="20"
            VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.30" Color="#FF0B1420" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：和「装整合包」检查窗一致 -->
        <Grid Grid.Row="0" Margin="24,20,22,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <v:PluginMark Width="40" Height="40" Size="40" Spec="pack" Kind="整合包"
                        VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="导入整合包" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="HeaderSub" Style="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
          <Border Grid.Column="2" Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource LineBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="7,1,7,2" VerticalAlignment="Center">
            <TextBlock x:Name="SchemaBadge" FontSize="{StaticResource FsMicro}"
                       Foreground="{StaticResource TextSecondary}" />
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,22,6">
          <StackPanel>
            <!-- 包 -->
            <Border Style="{StaticResource Slab}" Padding="20,12,20,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Style="{StaticResource CardHead}" Text="包" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock x:Name="PackTitle" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                  <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource LineBorder}"
                          BorderThickness="1" CornerRadius="8" Padding="7,1,7,2" Margin="8,0,0,0"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="PackVersion" FontSize="{StaticResource FsMicro}"
                               Foreground="{StaticResource TextSecondary}" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="PackMeta" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 目标 -->
            <Border Style="{StaticResource Slab}" Padding="20,12,20,14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Style="{StaticResource CardHead}" Text="装到哪里" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="ExistingRadio" GroupName="target" Content="现有实例"
                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}"
                               VerticalAlignment="Center" Checked="ExistingRadio_Checked" />
                  <ComboBox x:Name="InstanceCombo" Grid.Column="1" Height="28" Margin="14,0,0,0"
                            VerticalContentAlignment="Center" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="NewRadio" GroupName="target" Content="新建实例"
                               Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}"
                               VerticalAlignment="Center" Checked="NewRadio_Checked" />
                  <TextBox x:Name="NewNameBox" Grid.Column="1" Height="28" Margin="14,0,0,0"
                           Padding="6,3" VerticalContentAlignment="Center" />
                </Grid>
                <TextBlock x:Name="TargetHint" Style="{StaticResource Muted}" Margin="0,10,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 冲突（有才显示） -->
            <Border x:Name="ConflictPanel" Style="{StaticResource Slab}" Padding="20,12,20,14"
                    Margin="0,0,0,10" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Style="{StaticResource CardHead}" Text="冲突" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                  <TextBlock x:Name="ConflictTitle" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                  <TextBlock Text="全部" Style="{StaticResource Muted}" Margin="16,0,6,0"
                             VerticalAlignment="Center" />
                  <ComboBox x:Name="BulkCombo" Width="88" Height="26" SelectedIndex="0"
                            SelectionChanged="Bulk_Changed">
                    <ComboBoxItem Content="保留" />
                    <ComboBoxItem Content="替换" />
                    <ComboBoxItem Content="跳过" />
                  </ComboBox>
                </StackPanel>

                <ItemsControl x:Name="ConflictList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}"
                                     FontSize="{StaticResource FsSmall}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Times}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="84" Height="26" Margin="12,0,0,0"
                                  ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Text="保留 = 你的文件不动，新版存成 .pack-new；替换前会备份你的版本。" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerText}"
                       FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="2,2,0,0"
                       Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineDivider}"
                Padding="24,13,22,14">
          <Grid>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource Btn}" Content="取消" Height="35" MinWidth="110"
                      Margin="0,0,10,0" Click="Cancel_Click" />
              <Button x:Name="StartBtn" Style="{StaticResource BtnPrimary}" Content="开始导入"
                      Height="35" MinWidth="130" Click="Start_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
