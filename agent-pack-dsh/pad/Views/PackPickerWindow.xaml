<Window x:Class="Pad.Views.PackPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="装整合包" Width="1060" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- 安装概念（D107）：包库选择器。暗场 + 白卡；列表行 = 包自己的 icon / 名字版本 / 预检徽标 / 动作。 -->
  <Window.Resources>
    <!-- 徽标：Tone = ok|warn|bad|info|none（内容来自预检）。 -->
    <Style x:Key="Badge" TargetType="ContentControl">
      <Setter Property="Background" Value="{StaticResource BgSubtle}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
      <Setter Property="FontSize" Value="{StaticResource FsMicro}" />
      <Setter Property="Padding" Value="7,1,7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="ok">
          <Setter Property="Background" Value="{StaticResource SuccessWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource SuccessWash}" />
          <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn">
          <Setter Property="Background" Value="{StaticResource WarningWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource WarningWash}" />
          <Setter Property="Foreground" Value="{StaticResource WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="bad">
          <Setter Property="Background" Value="{StaticResource DangerWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource DangerWash}" />
          <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="info">
          <Setter Property="Background" Value="{StaticResource AccentWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentWash}" />
          <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Border Background="#8C0B1420" />
    <Border Width="980" MaxHeight="612" Background="{StaticResource BgCard}" CornerRadius="20"
            VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.30"
                          Color="#FF0B1420" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：装整合包 + 目标实例 -->
        <Grid Grid.Row="0" Margin="26,22,24,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <v:PluginMark x:Name="HeaderMark" Width="44" Height="44" Size="44"
                        Spec="pack" Kind="整合包" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="装整合包" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="HeaderSub" Style="{StaticResource Muted}" Margin="0,3,0,0"
                       Text="从本机包库选一个，先检查再装；不会盲目动实例内容。" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="目标实例：" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock x:Name="TargetText" FontWeight="SemiBold" FontSize="{StaticResource FsBody}"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            <ContentControl x:Name="CurrentPill" Style="{StaticResource PillAccent}" Margin="8,0,0,0"
                            Content="当前选中" />
          </StackPanel>
        </Grid>

        <!-- 搜索 -->
        <Grid Grid.Row="1" Margin="26,0,24,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Height="34" Tag="搜索本机包库：名字 / 版本 / 内核…"
                   TextChanged="Search_Changed" />
          <TextBlock Grid.Column="1" x:Name="CountText" Style="{StaticResource Muted}"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <!-- 包列表（加载时换成骨架） -->
        <Grid Grid.Row="2" Margin="26,0,24,8">
          <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PackRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BgPage}" BorderThickness="1"
                          BorderBrush="{StaticResource LineBorder}" CornerRadius="12"
                          Padding="14,12,12,12" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <v:PluginMark Width="44" Height="44" Size="44" VerticalAlignment="Center"
                                    IconPath="{Binding IconPath}" Spec="{Binding Title}" Kind="整合包" />
                      <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}"
                                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                          <TextBlock Text="{Binding VersionText}" Style="{StaticResource Mono}"
                                     FontSize="{StaticResource FsSmall}"
                                     Foreground="{StaticResource TextMuted}" Margin="9,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Muted}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding Badges}" Margin="0,7,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <ContentControl Style="{StaticResource Badge}" Content="{Binding Text}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Height="34"
                              Padding="18,0" VerticalAlignment="Center" Tag="{Binding}"
                              Content="{Binding ActionText}" Click="RowAction_Click" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel x:Name="SkeletonRows" VerticalAlignment="Top" Visibility="Collapsed">
            <Border Style="{StaticResource Skeleton}" Height="78" Margin="0,0,0,8" />
            <Border Style="{StaticResource Skeleton}" Height="78" Margin="0,0,0,8" />
            <Border Style="{StaticResource Skeleton}" Height="78" />
          </StackPanel>

          <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                     Text="本机包库没有整合包。" />
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineDivider}"
                Padding="26,14,24,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="预检会先跑：内核匹配 / 插件下架 / 兼容豁免 / 版本冲突，不会盲目装。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="FromFileBtn" Style="{StaticResource BtnGhost}" Content="从文件…"
                      Height="34" Padding="16,0" Margin="0,0,10,0" Click="FromFile_Click" />
              <Button Style="{StaticResource Btn}" Content="取消" Height="34" Padding="20,0"
                      Click="Close_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
