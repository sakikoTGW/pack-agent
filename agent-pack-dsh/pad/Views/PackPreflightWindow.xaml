<Window x:Class="Pad.Views.PackPreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="装整合包" Width="1020" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- 安装概念（D107）：两阶段同窗——阶段1「安装前检查」→ 阶段2「安装报告」。
       不静默：所有跳过/失败/豁免都列出来。 -->
  <Window.Resources>
    <v:BoolToVis x:Key="B2V" />
    <v:BoolToVis x:Key="B2VNot" Invert="True" />
    <Style x:Key="Badge" TargetType="ContentControl">
      <Setter Property="Background" Value="{StaticResource BgSubtle}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
      <Setter Property="FontSize" Value="{StaticResource FsMicro}" />
      <Setter Property="Padding" Value="7,1,7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="ok">
          <Setter Property="Background" Value="{StaticResource SuccessWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource SuccessWash}" />
          <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn">
          <Setter Property="Background" Value="{StaticResource WarningWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource WarningWash}" />
          <Setter Property="Foreground" Value="{StaticResource WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="bad">
          <Setter Property="Background" Value="{StaticResource DangerWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource DangerWash}" />
          <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="info">
          <Setter Property="Background" Value="{StaticResource AccentWash}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentWash}" />
          <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 检查/报告共用的一行：状态字 + 标题/说明 + 右侧徽标。 -->
    <Style x:Key="Marker" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Width" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="ok">
          <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn">
          <Setter Property="Foreground" Value="{StaticResource WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="bad">
          <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="info">
          <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="LineTemplate">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Marker}" Style="{StaticResource Marker}" />
        <StackPanel Grid.Column="1" Margin="8,0,12,0">
          <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}"
                     Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                     TextWrapping="Wrap" Visibility="{Binding HasDetail, Converter={StaticResource B2V}}" />
        </StackPanel>
        <ContentControl Grid.Column="2" Style="{StaticResource Badge}" Content="{Binding BadgeText}"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasBadge, Converter={StaticResource B2V}}" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Border Background="#8C0B1420" />
    <Border Width="940" MaxHeight="640" Background="{StaticResource BgCard}" CornerRadius="20"
            VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.30"
                          Color="#FF0B1420" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：阶段标题 + 包 → 实例 -->
        <Grid Grid.Row="0" Margin="28,22,26,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <v:PluginMark x:Name="HeaderMark" Width="40" Height="40" Size="40"
                        Spec="pack" Kind="整合包" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="StageTitle" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Text="安装前检查" />
            <TextBlock x:Name="StageSub" Style="{StaticResource Muted}" Margin="0,3,0,0"
                       Text="先算清楚会发生什么，再由你决定。" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PackLabel" FontWeight="SemiBold" FontSize="{StaticResource FsBody}"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            <TextBlock Text="  →  " Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock x:Name="InstanceLabel" FontWeight="SemiBold" FontSize="{StaticResource FsBody}"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- 阶段 1：安装前检查 -->
        <ScrollViewer x:Name="StageCheck" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,0,26,8">
          <StackPanel>
            <ItemsControl x:Name="CheckLines" ItemTemplate="{StaticResource LineTemplate}" />
            <ItemsControl x:Name="DetailLines" ItemTemplate="{StaticResource LineTemplate}"
                          Margin="0,2,0,0" />
            <StackPanel x:Name="Options" Margin="26,6,0,0">
              <CheckBox x:Name="AcceptRiskBox" Margin="0,0,0,8" Visibility="Collapsed"
                        Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}" />
              <CheckBox x:Name="SkipMissingBox" Visibility="Collapsed"
                        Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FsBody}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 阶段 2：安装报告 -->
        <ScrollViewer x:Name="StageReport" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,0,26,8"
                      Visibility="Collapsed">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <ContentControl x:Name="StatusPill" Style="{StaticResource Badge}" FontSize="{StaticResource FsSmall}"
                              Padding="10,3,11,4" Margin="0,0,8,0" />
              <ContentControl x:Name="GapPill" Style="{StaticResource Badge}" FontSize="{StaticResource FsSmall}"
                              Padding="10,3,11,4" Margin="0,0,8,0" Visibility="Collapsed" />
              <TextBlock x:Name="LedgerText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl x:Name="StatTiles" Margin="0,0,0,16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BgPage}" BorderThickness="1"
                          BorderBrush="{StaticResource LineBorder}" CornerRadius="10"
                          Width="104" Padding="12,9,10,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimary}" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="ReportLines" ItemTemplate="{StaticResource LineTemplate}" />
            <TextBlock x:Name="ReportHint" Style="{StaticResource Muted}" Margin="26,2,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮（两个阶段各一组） -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineDivider}"
                Padding="28,14,26,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="只取消这一个包，不动实例其它内容。" />
            <StackPanel x:Name="CheckButtons" Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource Btn}" Content="取消" Height="36" Padding="22,0"
                      Margin="0,0,10,0" Click="Cancel_Click" />
              <Button x:Name="StartBtn" Style="{StaticResource BtnPrimary}" Content="开始安装"
                      Height="36" Padding="22,0" Click="Start_Click" />
            </StackPanel>
            <StackPanel x:Name="ReportButtons" Grid.Column="1" Orientation="Horizontal"
                        Visibility="Collapsed">
              <Button Style="{StaticResource BtnGhost}" Content="知道了" Height="36"
                      Padding="16,0" Margin="0,0,10,0" Click="Done_Click" />
              <Button Style="{StaticResource BtnGhost}" Content="重新导出这个包" Height="36"
                      Padding="16,0" Margin="0,0,10,0" Click="ReExport_Click" />
              <Button Style="{StaticResource Btn}" Content="打开实例" Height="36" Padding="18,0"
                      Margin="0,0,10,0" Click="OpenInstance_Click" />
              <Button x:Name="RepairBtn" Style="{StaticResource BtnPrimary}" Content="去修复缺少项"
                      Height="36" Padding="18,0" Click="Repair_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
