<Window x:Class="Pad.Views.PluginDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        xmlns:local="clr-namespace:Pad.Views"
        Title="插件详情" Width="800" Height="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource BgPage}">
  <!-- 插件详情：App Store 式版面（头图卡 + 大截图横滑 + 描述 + 信息卡）。 -->
  <Window.Resources>
    <local:PathToBmp x:Key="PathBmp" />
  </Window.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="34,24,34,34" HorizontalAlignment="Center" MaxWidth="640">

        <!-- 头图卡：App Store 顶部（图标 / 名字 / 版本 / 获取按钮） -->
        <Border Background="{StaticResource BgCard}" CornerRadius="20" Padding="24,24,22,22">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <v:PluginMark x:Name="DetailIcon" Width="112" Height="112" Size="112"
                          VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="20,2,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="DetailName" FontSize="26" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
              <TextBlock x:Name="DetailSpec" Style="{StaticResource Mono}"
                         FontSize="{StaticResource FsSmall}" Foreground="{StaticResource TextMuted}"
                         Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock x:Name="DetailVersion" Style="{StaticResource Mono}"
                           FontSize="{StaticResource FsSmall}"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <Border x:Name="DetailUpdateBadge" Margin="10,0,0,0" CornerRadius="8"
                        Padding="8,3,9,3" Background="{StaticResource Accent}" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <v:Ico Glyph="{StaticResource I.Refresh}" Height="10"
                           Foreground="{StaticResource TextOnAccent}" />
                    <TextBlock x:Name="DetailUpdateText" Margin="4,0,0,0"
                               FontSize="{StaticResource FsMicro}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnAccent}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button x:Name="UpdateBtn" Style="{StaticResource BtnPrimary}"
                      Content="更新" Height="38" Padding="24,0" FontSize="15" FontWeight="SemiBold"
                      Click="Update_Click" />
              <Button x:Name="FavBtn" Style="{StaticResource BtnGhost}" Content="☆ 收藏"
                      Height="30" Margin="0,8,0,0" Click="Fav_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 预览：大截图横滑，所有图一样大（App Store 的截图带） -->
        <TextBlock Text="预览" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" Margin="2,28,0,12" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Padding="0,0,0,10">
          <ItemsControl x:Name="DetailShots" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="350" Height="218" CornerRadius="14" Margin="0,0,12,0"
                        ClipToBounds="True" Background="{StaticResource BgSidebar}">
                  <Image Source="{Binding Converter={StaticResource PathBmp}}"
                         Stretch="UniformToFill" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="DetailShotHint" Text="正在从仓库加载图片…" Visibility="Collapsed"
                   HorizontalAlignment="Left" Margin="2,0,0,10"
                   FontSize="{StaticResource FsSmall}" Foreground="{StaticResource TextMuted}" />

        <!-- 描述 -->
        <TextBlock Text="描述" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" Margin="2,24,0,10" />
        <TextBlock x:Name="DetailDesc" FontSize="{StaticResource FsBody}" LineHeight="25"
                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                   TextAlignment="Left" Margin="2,0,2,0" />

        <ItemsControl x:Name="DetailTags" Margin="2,16,0,0" HorizontalAlignment="Left">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Left" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ContentControl Style="{StaticResource Pill}" Content="{Binding}" Margin="0,0,6,6" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 信息卡 -->
        <TextBlock Text="信息" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" Margin="2,22,0,10" />
        <Border Background="{StaticResource BgCard}" CornerRadius="16" Padding="18,6,18,6">
          <StackPanel>
            <Grid Height="38">
              <TextBlock Text="版本" Style="{StaticResource Muted}" FontSize="{StaticResource FsSmall}"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="InfoVersion" Style="{StaticResource Mono}"
                         FontSize="{StaticResource FsSmall}" Foreground="{StaticResource TextPrimary}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{StaticResource LineDivider}" />
            <Grid Height="38">
              <TextBlock Text="最新版本" Style="{StaticResource Muted}" FontSize="{StaticResource FsSmall}"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="InfoLatest" Style="{StaticResource Mono}"
                         FontSize="{StaticResource FsSmall}" Foreground="{StaticResource TextPrimary}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{StaticResource LineDivider}" />
            <Grid Height="38">
              <TextBlock Text="作用域" Style="{StaticResource Muted}" FontSize="{StaticResource FsSmall}"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="InfoProfile" Style="{StaticResource Mono}"
                         FontSize="{StaticResource FsSmall}" Foreground="{StaticResource TextPrimary}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{StaticResource LineDivider}" />
            <Grid Height="38">
              <TextBlock Text="来源" Style="{StaticResource Muted}" FontSize="{StaticResource FsSmall}"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="DetailMeta" FontSize="{StaticResource FsMicro}"
                         Foreground="{StaticResource TextSecondary}" TextAlignment="Right"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
