<Window x:Class="Pad.Views.PluginDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="插件详情" Width="700" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource BgPage}">
  <!-- 插件详情 = 一个自己的窗口，按插件市场的版面渲染（图标/名字/版本/简介/动作）。 -->
  <Border Padding="26,22,26,20" Background="{StaticResource BgCard}"
          BorderBrush="{StaticResource LineBorder}" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <v:PluginMark x:Name="DetailIcon" Width="56" Height="56" Size="56" />
        <StackPanel Margin="16,1,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="DetailName" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                     MaxWidth="560" />
          <TextBlock x:Name="DetailSpec" Style="{StaticResource Mono}" FontSize="{StaticResource FsMicro}"
                     Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="DetailVersion" Style="{StaticResource Mono}"
                       FontSize="{StaticResource FsSmall}" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" />
            <Border x:Name="DetailUpdateBadge" Margin="10,0,0,0" CornerRadius="6" Padding="7,3,8,3"
                    Background="{StaticResource Accent}" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <v:Ico Glyph="{StaticResource I.Refresh}" Height="10"
                       Foreground="{StaticResource TextOnAccent}" />
                <TextBlock x:Name="DetailUpdateText" Margin="4,0,0,0"
                           FontSize="{StaticResource FsMicro}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnAccent}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="DetailDesc" FontSize="{StaticResource FsBody}" LineHeight="23"
                     TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
          <ItemsControl x:Name="DetailTags" Margin="0,16,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Style="{StaticResource Pill}" Content="{Binding}" Margin="0,0,6,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="DetailMeta" Style="{StaticResource Muted}" Margin="0,14,0,0"
                     FontSize="{StaticResource FsMicro}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="UpdateBtn" Style="{StaticResource BtnPrimary}" Content="更新"
                Height="34" Padding="18,0" Click="Update_Click" />
        <Button x:Name="DirBtn" Style="{StaticResource Btn}" Content="打开目录"
                Height="34" Padding="16,0" Margin="10,0,0,0" Click="Dir_Click" />
        <Button x:Name="RemoveBtn" Style="{StaticResource BtnDanger}" Content="卸载"
                Height="34" Padding="16,0" Margin="10,0,0,0" Click="Remove_Click" />
        <Button Style="{StaticResource Btn}" Content="关闭" Height="34" Padding="16,0"
                Margin="10,0,0,0" Click="Close_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
