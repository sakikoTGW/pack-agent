<UserControl x:Class="Pad.Views.PluginMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Pad.Views">
  <!-- 插件市场式小图标：有真图标用真图标；没有就按插件类型给一枚彩色字形方块——
       保证列表里每个插件都有图标，不会出现空白/通用胶囊。 -->
  <Grid x:Name="Root">
    <Border x:Name="Tile" CornerRadius="8">
      <v:Ico x:Name="GlyphIcon" Width="15" Height="15"
             HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Image x:Name="Pic" Stretch="Uniform" Visibility="Collapsed" />
  </Grid>
</UserControl>
