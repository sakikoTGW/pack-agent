<UserControl x:Class="Pad.Views.ProjectRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 舞台常驻侧栏本体：项目列表 / 实例列表 / 关系树；换内容不换位置 -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="20,16,10,10">
      <Button x:Name="CollapseBtn" DockPanel.Dock="Right" Content="‹"
              Style="{StaticResource BtnGhost}" Width="24" Height="22" Padding="0"
              VerticalAlignment="Top" Visibility="Collapsed"
              Click="Collapse_Click" ToolTip="收起侧栏" />
      <StackPanel Margin="0,0,6,0">
        <TextBlock x:Name="RailTitle" Text="项目" FontSize="11" Foreground="{StaticResource TextMuted}" />
        <TextBlock x:Name="Summary" Margin="0,4,0,0" FontSize="10"
                   Foreground="{StaticResource TextMuted}" />
        <!-- 项目 / 实例 两条表示（D69，对齐原型 v4）。 -->
        <StackPanel x:Name="SegPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
          <Button x:Name="SegProj" Content="项目" Height="24" Padding="16,0" Margin="0,0,6,0"
                  Style="{StaticResource BtnSm}" Click="SegProj_Click" />
          <Button x:Name="SegInst" Content="实例" Height="24" Padding="16,0"
                  Style="{StaticResource BtnSm}" Click="SegInst_Click" />
        </StackPanel>
        <!-- 项目视角才出现：按名字过滤（D66）；占位文案和演示稿一致（D68）。 -->
        <Grid Margin="0,6,0,0">
          <TextBox x:Name="SearchBox" Visibility="Collapsed" Height="24"
                   Padding="6,0" FontSize="11" VerticalContentAlignment="Center"
                   Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                   BorderBrush="{StaticResource LineBorder}" BorderThickness="1"
                   TextChanged="Search_Changed" ToolTip="按名字过滤项目" />
          <TextBlock x:Name="SearchHint" Text="搜索项目 / 目录" Visibility="Collapsed"
                     IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="11" Foreground="{StaticResource TextMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </StackPanel>
    </DockPanel>

    <!-- 底部：导入整合包（对齐原型 v4） -->
    <Border x:Name="FootPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="12,0,12,12">
      <StackPanel>
        <Button x:Name="ImportBtn" Content="导入整合包" Height="30"
                HorizontalContentAlignment="Left" Padding="10,0"
                Style="{StaticResource BtnSm}" Click="Import_Click"
                ToolTip="从整合包建一个项目" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Rows" Margin="12,0,12,14" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
