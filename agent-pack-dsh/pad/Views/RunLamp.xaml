<UserControl x:Class="Pad.Views.RunLamp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="12" Height="12" Visibility="Collapsed">
  <Grid x:Name="Lamp" Width="12" Height="12">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="LampScale" />
        <TranslateTransform x:Name="LampBob" />
      </TransformGroup>
    </Grid.RenderTransform>
    <Ellipse Width="12" Height="12" Fill="#3FBF73" Opacity="0.18">
      <Ellipse.Effect>
        <DropShadowEffect Color="#3FBF73" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
      </Ellipse.Effect>
    </Ellipse>
    <Ellipse x:Name="LampDot" Width="6.5" Height="6.5" Fill="#3FBF73" />
    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever">
            <!-- 闪：不写字，只让灯呼吸 -->
            <DoubleAnimation Storyboard.TargetName="LampDot" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.9" AutoReverse="True">
              <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- 呼吸：缩放 -->
            <DoubleAnimation Storyboard.TargetName="LampScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.22" Duration="0:0:1.6" AutoReverse="True">
              <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LampScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.22" Duration="0:0:1.6" AutoReverse="True">
              <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- 轻微抖动 -->
            <DoubleAnimation Storyboard.TargetName="LampBob" Storyboard.TargetProperty="Y"
                             From="0" To="-0.8" Duration="0:0:0.7" AutoReverse="True">
              <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
  </Grid>
</UserControl>
