                </Grid.ColumnDefinitions>
                <TextBlock Text="registries 相对路径" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="RegistriesRelBox" Height="28" LostFocus="Other_Save"
                         FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FsSmall}" />
              </Grid>
              <Grid Height="28" Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="截图延时" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="ShotDelayBox" Height="28" LostFocus="Other_Save"
                         FontFamily="{StaticResource FontMono}" />
                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
              <Grid Height="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="市场截图延时" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="ShotMarketDelayBox" Height="28" LostFocus="Other_Save"
                         FontFamily="{StaticResource FontMono}" />
                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Slab}">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="注册表覆盖"
                              v:Ico.Of="{StaticResource I.Pack}" />
              <Button Style="{StaticResource BtnWide}" Content="打开 library/registries"
                      HorizontalAlignment="Left" Click="OpenRegistries_Click"
                      v:Ico.Of="{StaticResource I.Folder}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Slab}">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="升级"
                              v:Ico.Of="{StaticResource I.Upload}" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="启动器" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="1" x:Name="PadUpdateLine" Style="{StaticResource Mono}" />
              </Grid>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="DSH 发行号" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="1" x:Name="DshUpdateLine" Style="{StaticResource Mono}" />
              </Grid>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Content="检查升级" Click="CheckUpdate_Click"
                        v:Ico.Of="{StaticResource I.Refresh}" />
                <Button Style="{StaticResource Btn}" Content="去下载页" Margin="8,0,0,0"
                        Click="GotoDownload_Click" v:Ico.Of="{StaticResource I.Download}" />
                <Button Style="{StaticResource Btn}" Content="诊断" Margin="8,0,0,0"
                        Click="Doctor_Click" ToolTip="跑 launcher doctor"
                        v:Ico.Of="{StaticResource I.Search}" />
              </StackPanel>
              <Grid Height="28" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="更新通道" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="UpdateChannelBox" Width="160" Height="28"
                          SelectionChanged="Other_Sel">
                  <ComboBoxItem Tag="release" Content="release" />
                  <ComboBoxItem Tag="off" Content="关掉检查" />
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Slab}">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="设置导入导出"
                              v:Ico.Of="{StaticResource I.Copy}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <Button Style="{StaticResource Btn}" Content="导出设置" Click="ExportSettings_Click"
                        v:Ico.Of="{StaticResource I.Upload}"
                        ToolTip="写出 pad-settings.json" />
                <Button Style="{StaticResource Btn}" Content="导入设置" Margin="8,0,0,0"
                        Click="ImportSettings_Click" v:Ico.Of="{StaticResource I.Download}"
                        ToolTip="导入前会备份当前 pad.json" />
              </StackPanel>
              <Button Style="{StaticResource Btn}" Content="导出便携目录" Margin="0,10,0,0"
                      Click="ExportPortable_Click" v:Ico.Of="{StaticResource I.Pack}"
                      ToolTip="把当前 PAD + 空 .pack-launcher（可带当前实例 pinst）打到一个目录" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Slab}" Padding="25,22,25,25">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="关于" Margin="0,0,0,8"
                              v:Ico.Of="{StaticResource I.Data}" />
              <TextBlock x:Name="AboutLine" Style="{StaticResource Mono}" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Row}" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                  <TextBlock x:Name="IdentifyLine" Style="{StaticResource Mono}" />
                </Border>
                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="复制识别码"
                        VerticalAlignment="Center" Click="CopyIdentify_Click"
                        v:Ico.Of="{StaticResource I.Copy}" />
              </Grid>
              <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                         Text="pack-agent for DSH" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
