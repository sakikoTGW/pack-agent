<UserControl x:Class="Pad.Views.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pad.Views"
             xmlns:v="clr-namespace:Pad.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <UserControl.Resources>
    <local:BoolToVis x:Key="B2V" />
    <local:BoolToVis x:Key="B2VNot" Invert="True" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="25,20,25,0">
      <Grid Margin="0,0,0,12">
        <ContentControl Style="{StaticResource SlabHead}" Content="下载内容"
                        v:Ico.Of="{StaticResource I.Download}" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource BtnSm}" Content="全部清除" Margin="0,0,8,0"
                  Click="Clear_Click" ToolTip="从列表中删除已完成的，不删已装的文件" />
          <Button Style="{StaticResource IcoBtn}" Click="Refresh_Click" ToolTip="刷新">
            <v:Ico Glyph="{StaticResource I.Refresh}" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
      <TextBox x:Name="SearchBox" Height="28" MaxWidth="420" HorizontalAlignment="Left"
               MinWidth="280" Tag="搜索下载内容" TextChanged="Search_Changed"
               KeyDown="Search_Key" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="25,16,25,25" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Border Style="{StaticResource Slab}" Padding="25,22,25,25" MaxWidth="380"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding NoneRunning, Converter={StaticResource B2V}}">
          <StackPanel>
            <ContentControl Style="{StaticResource PictLg}" v:Ico.Of="{StaticResource I.Download}"
                            HorizontalAlignment="Left" Margin="0,0,0,12" />
            <TextBlock Text="没有下载内容" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="装发行号或装组合包会出现在这里" Style="{StaticResource Muted}"
                       Margin="0,8,0,0" />
            <Button Style="{StaticResource BtnWidePrimary}" Content="去下载"
                    HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="Download_Click"
                    v:Ico.Of="{StaticResource I.Download}" />
          </StackPanel>
        </Border>

        <ItemsControl x:Name="JobList"
                      Visibility="{Binding NoneRunning, Converter={StaticResource B2VNot}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Height="72" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Style="{StaticResource MonogramTile}"
                                Content="{Binding Monogram}" VerticalAlignment="Center"
                                Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}"
                             TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                  <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis" Text="{Binding Line}" />
                  <ProgressBar Style="{StaticResource Meter}" Height="4" Margin="0,8,0,0"
                               Minimum="0" Maximum="100"
                               Value="{Binding Percent, Mode=OneWay}"
                               Visibility="{Binding ShowMeter, Converter={StaticResource B2V}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource BtnDanger}" Content="取消" Height="26"
                          Padding="11,0" FontSize="{StaticResource FsSmall}"
                          Click="Cancel_Click" Tag="{Binding Job}"
                          Visibility="{Binding CanCancel, Converter={StaticResource B2V}}"
                          v:Ico.Of="{StaticResource I.Stop}" />
                  <Button Style="{StaticResource BtnSm}" Content="在文件夹中显示"
                          Click="Folder_Click" Tag="{Binding Job}"
                          Visibility="{Binding CanForget, Converter={StaticResource B2V}}"
                          v:Ico.Of="{StaticResource I.Folder}" />
                  <Button Style="{StaticResource IcoBtn}" Margin="6,0,0,0"
                          Click="Forget_Click" Tag="{Binding Job}"
                          Visibility="{Binding CanForget, Converter={StaticResource B2V}}"
                          ToolTip="从列表中删除">
                    <v:Ico Glyph="{StaticResource I.Close}" Height="10" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
