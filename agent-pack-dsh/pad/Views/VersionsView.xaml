<UserControl x:Class="Pad.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pad.Views"
             xmlns:v="clr-namespace:Pad.Views"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:dat="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <UserControl.Resources>
    <local:BoolToVis x:Key="B2V" />
    <local:BoolToVis x:Key="B2VNot" Invert="True" />
    <local:MiddleEllipsis x:Key="Mid" Max="36" />
    <local:Initial x:Key="Initial" />
    <local:PackAction x:Key="PackAction" />
    <CollectionViewSource x:Key="InstSrc" Source="{Binding Instances}" Filter="InstSrc_Filter" />
    <CollectionViewSource x:Key="LaunchSrc" Source="{Binding Launchables}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription PropertyName="GroupOrder" Direction="Ascending" />
      </CollectionViewSource.SortDescriptions>
      <CollectionViewSource.GroupDescriptions>
        <dat:PropertyGroupDescription PropertyName="Kind" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource LineBorder}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,4,0,8">
            <TextBlock Text="实例列表" Style="{StaticResource NavGroup}" />
            <ListBox x:Name="InstanceList" Style="{StaticResource PlainList}"
                     Margin="10,0,10,0"
                     ItemsSource="{Binding Source={StaticResource InstSrc}}"
                     SelectedItem="{Binding SelectedInstance, Mode=OneWay}"
                     SelectionChanged="InstanceList_Sel"
                     PreviewMouseRightButtonDown="InstanceList_Right">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="打开 $DSH_HOME" Click="OpenHome_Click" />
                  <MenuItem Header="打开工作区" Click="OpenWorkspace_Click" />
                  <MenuItem Header="打开日志" Click="OpenLogs_Click" />
                  <MenuItem Header="打开 $DSH_HOME/profiles" Click="OpenProfiles_Click" />
                  <MenuItem Header="打开投影目录" Click="OpenProjection_Click" />
                  <Separator />
                  <MenuItem Header="克隆…" Click="Clone_Click" />
                  <MenuItem Header="改名…" Click="Rename_Click" />
                  <MenuItem Header="改钉发行号…" Click="Pin_Click" />
                  <MenuItem Header="收藏" Click="Star_Click" />
                  <MenuItem Header="设置分类…" Click="Category_Click" />
                  <Separator />
                  <MenuItem Header="写快捷方式" Click="Shortcut_Click" />
                  <MenuItem Header="导出 pinst.zip" Click="Export_Click" />
                  <Separator />
                  <MenuItem Header="删除实例" Click="Delete_Click" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Height="40">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:InstMark Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="★" FontSize="{StaticResource FsSmall}" Margin="4,0,0,0"
                                   Foreground="{StaticResource Accent}"
                                   Visibility="{Binding Display.Star, Converter={StaticResource B2V}}" />
                      </StackPanel>
                      <TextBlock Style="{StaticResource Mono}" FontSize="{StaticResource FsMicro}"
                                 Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"
                                 Text="{Binding Home, Converter={StaticResource Mid}}"
                                 ToolTip="{Binding Home}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IcoBtn}" Width="26" Height="26"
                            Click="Gear_Click" ToolTip="设置" VerticalAlignment="Center">
                      <v:Ico Glyph="{StaticResource I.Gear}" Height="12" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
          <TextBlock Text="添加或导入" Style="{StaticResource NavGroup}" Margin="13,8,5,4" />
          <Button Style="{StaticResource PickRow}" Height="34" Margin="8,0,8,0"
                  Click="Create_Click" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <v:Ico Glyph="{StaticResource I.Plus}" Height="12" Margin="4,0,8,0"
                     Foreground="{StaticResource TextMuted}" />
              <TextBlock Text="新建实例" VerticalAlignment="Center"
                         Foreground="{StaticResource TextBody}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PickRow}" Height="34" Margin="8,0,8,0"
                  Click="Adopt_Click" HorizontalContentAlignment="Left"
                  ToolTip="把本机一份 $DSH_HOME 收成实例">
            <StackPanel Orientation="Horizontal">
              <v:Ico Glyph="{StaticResource I.Upload}" Height="12" Margin="4,0,8,0"
                     Foreground="{StaticResource TextMuted}" />
              <TextBlock Text="添加已有文件夹" VerticalAlignment="Center"
                         Foreground="{StaticResource TextBody}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PickRow}" Height="34" Margin="8,0,8,0"
                  Click="ImportPack_Click" HorizontalContentAlignment="Left"
                  ToolTip="选 .pack.zip / .pinst.zip，走 import">
            <StackPanel Orientation="Horizontal">
              <v:Ico Glyph="{StaticResource I.Pack}" Height="12" Margin="4,0,8,0"
                     Foreground="{StaticResource TextMuted}" />
              <TextBlock Text="导入整合包" VerticalAlignment="Center"
                         Foreground="{StaticResource TextBody}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="25,25,25,10" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- 整合包（插件部分）= 组件 + 对应内核（PCL「可安装 Mod」位）：本机搜到的整合包，选中后建实例。 -->
        <Border Style="{StaticResource Slab}" Padding="20,16,18,14" Margin="0,0,0,10">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource BtnPrimary}" Content="导出" Click="MakePack_Click"
                        v:Ico.Of="{StaticResource I.Download}" Margin="0,0,8,0"
                        ToolTip="把整合包导出成 .pack.zip" />
                <Button Style="{StaticResource Btn}" Content="刷新"
                        Click="RefreshPackCatalog_Click" v:Ico.Of="{StaticResource I.Data}" />
              </StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="整合包"
                              v:Ico.Of="{StaticResource I.Pack}" />
            </DockPanel>
            <ItemsControl x:Name="PackList" ItemsSource="{Binding PackCatalog}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Slab}" Padding="14,10,12,10" Margin="0,0,0,6"
                          ToolTip="{Binding Path}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="导出便携包…" Click="ExportPack_Click" />
                        <MenuItem Header="导出整合包…" Click="ExportPackPortable_Click" />
                        <MenuItem Header="导出整合包（文件夹）…" Click="ExportPackPortableFolder_Click" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentControl Grid.Column="0" Style="{StaticResource QuantMono}" Content="包"
                                      v:Ico.Of="{StaticResource I.Pack}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}"
                                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Version}" FontSize="{StaticResource FsMicro}"
                                     Foreground="{StaticResource TextMuted}" Margin="8,1,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="新建实例"
                              Tag="{Binding}" Click="CreateFromPack_Click" VerticalAlignment="Center"
                              ToolTip="用这个整合包新建实例" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="PackEmpty" Style="{StaticResource Slab}" Padding="14,10,14,10"
                    Visibility="Collapsed">
              <TextBlock x:Name="PackEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="本机没有整合包。" />
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Slab}" Padding="25,22,25,25" MaxWidth="420"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                Visibility="{Binding NeedsSetup, Converter={StaticResource B2V}}">
          <StackPanel>
            <TextBlock Text="无可用版本" Style="{StaticResource SectionTitle}"
                       HorizontalAlignment="Center" />
            <Border Height="2" Background="{StaticResource Accent}" Margin="0,9,0,0" />
            <Button Style="{StaticResource BtnWidePrimary}" Content="下载 DSH"
                    HorizontalAlignment="Stretch" Margin="0,15,0,0" Click="Download_Click"
                    v:Ico.Of="{StaticResource I.Download}" />
          </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
          <Border Style="{StaticResource Slab}" Padding="20,16,18,16">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="DSH 版本" Margin="0,0,0,10"
                              v:Ico.Of="{StaticResource I.Download}" />
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="PinRelease" Width="380" Height="28">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FsSmall}" />
                        <TextBlock Text="{Binding Source}" FontSize="{StaticResource FsMicro}"
                                   Foreground="{StaticResource TextMuted}" Margin="9,0,0,0"
                                   Visibility="{Binding HasSource, Converter={StaticResource B2V}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Style="{StaticResource Btn}" Content="改钉" Margin="8,0,0,0"
                        Click="PinApply_Click" v:Ico.Of="{StaticResource I.Check}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 容器 = 本实例的启动配置 + 本机探测到的桌面端 / TUI。识别到就列在这里；
               点一行只是选中（学 PCL），右侧只有设置齿轮。 -->
          <Border Style="{StaticResource Slab}" Padding="20,14,18,10">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="容器"
                              v:Ico.Of="{StaticResource I.Terminal}" />
              <ListBox x:Name="ContainerList" Style="{StaticResource PlainList}" Margin="0,6,0,0"
                       SelectionChanged="ContainerList_Sel">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding DetailText}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Kind}"
                                 FontSize="{StaticResource FsMicro}"
                                 Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                      <local:InstMark Grid.Column="1" Width="34" Height="34" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Margin="13,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsTitle}"
                                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                          <!-- 在跑 = 呼吸绿灯，不写字 -->
                          <local:RunLamp Width="12" Height="12" Margin="8,0,0,0"
                                         VerticalAlignment="Center" Running="{Binding Running}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="3" Style="{StaticResource IcoBtn}" Click="Setup_Click"
                              Tag="{Binding}" ToolTip="设置" VerticalAlignment="Center">
                        <v:Ico Glyph="{StaticResource I.Gear}" Height="13" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
