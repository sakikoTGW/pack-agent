{
  "name": "@sakikotgw/pad-session-jump",
  "version": "0.2.1",
  "description": "PAD session jump: open a DSH session from a URL fragment (?session= survives the web token redirect) or via the pad-gateway jump channel.",
  "type": "module",
  "main": "./lib/index.mjs",
  "license": "MIT",
  "author": "sakikotgw",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.7"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/client.test.mjs test/host.test.mjs"
  }
}
