<Window x:Class="Pad.Views.ApiImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="导入 API Key"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPage}"
        FontFamily="{StaticResource FontUI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Style="{StaticResource Slab}" Margin="18">
    <StackPanel>
      <ContentControl Style="{StaticResource SlabHead}" Content="导入 API Key"
                      v:Ico.Of="{StaticResource I.Key}" />
      <Grid Height="28" Margin="0,0,0,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="88" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="所属公司" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="ApiCompanyBox" Height="28" SelectionChanged="Company_Sel">
          <ComboBoxItem Tag="DEEPSEEK_API_KEY" Content="DeepSeek" />
          <ComboBoxItem Tag="OPENAI_API_KEY" Content="OpenAI" />
          <ComboBoxItem Tag="ANTHROPIC_API_KEY" Content="Anthropic" />
          <ComboBoxItem Tag="ACME_GATEWAY_API_KEY" Content="Acme" />
          <ComboBoxItem Tag="" Content="其他" />
        </ComboBox>
      </Grid>
      <Grid Height="30" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="88" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="refs 名" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="RefNameBox" Height="30" IsReadOnly="True"
                 Tag="DEEPSEEK_API_KEY" FontFamily="{StaticResource FontMono}" />
      </Grid>
      <Grid Height="30" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="88" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="密钥" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        <PasswordBox Grid.Column="1" x:Name="DeepseekKeyBox" Height="30" />
      </Grid>
      <TextBlock x:Name="DeepseekKeyHint" Style="{StaticResource Muted}" Margin="0,0,0,12"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Btn}" Content="取消" IsCancel="True" Click="Cancel_Click" />
        <Button Style="{StaticResource BtnPrimary}" Content="写入" Margin="8,0,0,0"
                IsDefault="True" Click="Write_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
