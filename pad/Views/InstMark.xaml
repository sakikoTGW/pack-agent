<UserControl x:Class="Pad.Views.InstMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Pad.Views">
  <Border x:Name="Tile" Background="{StaticResource AccentDeep}"
          CornerRadius="{StaticResource RadRow}" ClipToBounds="True">
    <Grid>
      <Image x:Name="Pic" Stretch="UniformToFill" Visibility="Collapsed" />
      <v:Ico x:Name="Glyph" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
             Foreground="{StaticResource TextOnAccent}" />
    </Grid>
  </Border>
</UserControl>
