<Window x:Class="Pad.Views.LaunchFloat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pad.Views"
        Title="启动"
        Width="400" Height="248"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource FontUI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Margin="22" Background="Transparent">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.38"
                        Color="#FF19222A" />
    </Border.Effect>
    <Border x:Name="Card" CornerRadius="14" Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource LineBorder}" BorderThickness="1" Padding="22,20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="44" Height="44" Margin="0,0,12,0">
              <Ellipse Stroke="{StaticResource AccentSoft}" StrokeThickness="3" />
              <Ellipse x:Name="Ring" Stroke="{StaticResource Accent}" StrokeThickness="3"
                       StrokeDashArray="9 18" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="RingSpin" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <v:Ico Glyph="{StaticResource I.Play}" Height="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource Accent}" />
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="LaunchTitle" Text="正在启动" Style="{StaticResource SectionTitle}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse x:Name="Dot0" Width="6" Height="7" Fill="{StaticResource Accent}"
                         Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Dot0T" />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot1" Width="6" Height="7" Fill="{StaticResource Accent}"
                         Opacity="0.7" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Dot1T" />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot2" Width="6" Height="7" Fill="{StaticResource Accent}"
                         Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Dot2T" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="LaunchPct" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Style="{StaticResource Mono}" FontSize="{StaticResource FsMicro}" />
        </Grid>

        <ProgressBar x:Name="LaunchMeter" Grid.Row="1" Style="{StaticResource Meter}" Height="7"
                     Minimum="0" Maximum="100" Value="0" Margin="0,16,0,0" />

        <TextBlock x:Name="LaunchStep" Grid.Row="2" Style="{StaticResource Muted}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />

        <Button Grid.Row="3" Style="{StaticResource IcoBtn}" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Click="Close_Click" ToolTip="关掉这张卡片">
          <v:Ico Glyph="{StaticResource I.Close}" Height="10" />
        </Button>
      </Grid>
    </Border>
  </Border>
</Window>
