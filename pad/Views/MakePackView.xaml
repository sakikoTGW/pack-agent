<UserControl x:Class="Pad.Views.MakePackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Pad.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" Padding="25,20,25,10" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- 身份：名字/版本/图标/说明 -->
        <Border Style="{StaticResource Slab}" Padding="20,16,18,16">
          <StackPanel>
            <ContentControl Style="{StaticResource SlabHead}" Content="整合包"
                            v:Ico.Of="{StaticResource I.Pack}" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="名字" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="NameBox" Height="28" Margin="0,0,14,8" />
              <TextBlock Grid.Column="2" Text="版本" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" x:Name="VersionBox" Height="28" Margin="0,0,10,8" />
              <Border Grid.Column="4" Grid.RowSpan="2" Width="52" Height="52" CornerRadius="10"
                      Background="{StaticResource BgCard}" BorderThickness="1"
                      BorderBrush="{StaticResource LineDivider}" Margin="6,0,0,0"
                      VerticalAlignment="Center" Cursor="Hand" ToolTip="选图标"
                      MouseLeftButtonUp="PickIcon_Click">
                <Grid>
                  <Image x:Name="IconPreview" Stretch="UniformToFill" />
                  <v:Ico x:Name="IconGlyph" Height="18" Glyph="{StaticResource I.Pack}"
                         Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Grid>
              </Border>
              <TextBlock Grid.Row="1" Text="说明" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DescBox" Height="28"
                       Margin="0,0,10,0" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 核心：单选 -->
        <Border Style="{StaticResource Slab}" Padding="20,14,18,10" Margin="0,10,0,0">
          <StackPanel>
            <ContentControl Style="{StaticResource SlabHead}" Content="核心"
                            v:Ico.Of="{StaticResource I.Gear}" />
            <ListBox x:Name="KernelList" Style="{StaticResource PlainList}" Margin="0,6,0,0"
                     SelectionChanged="Kernel_Sel" />
          </StackPanel>
        </Border>

        <!-- 容器：单选；决定 profile 和默认插件 -->
        <Border Style="{StaticResource Slab}" Padding="20,14,18,10" Margin="0,10,0,0">
          <StackPanel>
            <ContentControl Style="{StaticResource SlabHead}" Content="容器"
                            v:Ico.Of="{StaticResource I.Terminal}" />
            <ListBox x:Name="ContainerList" Style="{StaticResource PlainList}" Margin="0,6,0,0"
                     SelectionChanged="Container_Sel" />
          </StackPanel>
        </Border>

        <!-- 插件：多选，至少一个 -->
        <Border Style="{StaticResource Slab}" Padding="20,14,18,12" Margin="0,10,0,0">
          <StackPanel>
            <ContentControl Style="{StaticResource SlabHead}" Content="插件"
                            v:Ico.Of="{StaticResource I.Plus}" />
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
              <ItemsControl x:Name="PluginList" />
            </ScrollViewer>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="AddSpecBox" Height="28" Tag="再加一个组合包…" />
              <Button Grid.Column="1" Style="{StaticResource Btn}" Content="添加" Margin="8,0,0,0"
                      Click="AddSpec_Click" v:Ico.Of="{StaticResource I.Plus}" />
              <Button Grid.Column="2" Style="{StaticResource Btn}" Content="本地插件…" Margin="8,0,0,0"
                      Click="AddLocal_Click" v:Ico.Of="{StaticResource I.Upload}"
                      ToolTip="没上架的插件：选它的文件夹，整个塞进包里" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 导出成哪种：清单包（小、要联网装插件） / 便携包（带 PAD 和实例，打开就能跑） -->
        <Border Style="{StaticResource Slab}" Padding="20,14,18,16" Margin="0,10,0,0">
          <StackPanel>
            <ContentControl Style="{StaticResource SlabHead}" Content="导出形式"
                            v:Ico.Of="{StaticResource I.Download}" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <RadioButton x:Name="FormatList" Grid.Column="0" Style="{StaticResource RadioCard}"
                           GroupName="exportForm" Tag="list" IsChecked="True" Checked="Format_Changed" Margin="0">
                <StackPanel>
                  <TextBlock Text="便携包" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="只带清单；插件首次启动联网安装" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="FormatPortable" Grid.Column="2" Style="{StaticResource RadioCard}"
                           GroupName="exportForm" Tag="portable" Checked="Format_Changed" Margin="0">
                <StackPanel>
                  <TextBlock Text="整合包" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="带 PAD 和依赖，解压就能跑" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="FormatPortableFolder" Grid.Column="4" Style="{StaticResource RadioCard}"
                           GroupName="exportForm" Tag="portable-folder" Checked="Format_Changed" Margin="0">
                <StackPanel>
                  <TextBlock Text="整合包（文件夹）" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" />
                  <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="不压缩，直接给目录，快很多" />
                </StackPanel>
              </RadioButton>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderThickness="0,1,0,0"
            BorderBrush="{StaticResource LineDivider}" Padding="25,10">
      <Grid>
        <TextBlock x:Name="Hint" Style="{StaticResource Muted}" VerticalAlignment="Center"
                   Text="" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Btn}" Content="取消" Click="Cancel_Click" MinWidth="80" />
          <Button x:Name="MakeBtn" Style="{StaticResource BtnPrimary}" Content="导出"
                  Click="Make_Click" Margin="8,0,0,0" MinWidth="96"
                  v:Ico.Of="{StaticResource I.Download}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
