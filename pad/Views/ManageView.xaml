<UserControl x:Class="Pad.Views.ManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pad.Views"
             xmlns:v="clr-namespace:Pad.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <UserControl.Resources>
    <local:BoolToVis x:Key="B2V" />
    <local:BoolToVis x:Key="B2VNot" Invert="True" />
    <local:PathToBmp x:Key="PathBmp" />
    <local:StatePip x:Key="PipColor" />
    <local:ShortId x:Key="Short" Keep="8" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource LineBorder}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,0,10">
          <ContentControl Style="{StaticResource Pict}" v:Ico.Of="{StaticResource I.Data}"
                          Margin="0,0,8,0" />
          <TextBlock Text="实例" Style="{StaticResource Label}" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="InstList" Style="{StaticResource PlainList}" Margin="12,0,12,12"
                 ItemsSource="{Binding Instances}" SelectionChanged="Inst_Changed">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel local:Fx.Enter="row" Orientation="Horizontal">
                <v:InstMark Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                           DataContext="{Binding}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}"
                             Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Mono}" FontSize="{StaticResource FsMicro}"
                             Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"
                             Text="{Binding Dsh.Version}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- The management port's state, always in the same place. -->
      <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderThickness="0,0,0,1"
              BorderBrush="{StaticResource LineBorder}" Padding="25,15,25,16"
              Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="GwPip" Style="{StaticResource Pip}"
                      Background="{StaticResource InkDisabled}" />
              <TextBlock x:Name="TargetTitle" Text="管理口" FontSize="{StaticResource FsRow}"
                         FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,6,0,0">
              <TextBlock x:Name="StateText" Style="{StaticResource Muted}" Margin="0,0,15,0"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <ContentControl x:Name="AdBox" Style="{StaticResource QuantMono}" Margin="0"
                              v:Ico.Of="{StaticResource I.Globe}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StopBtn" Style="{StaticResource BtnSm}" Content="停止" Click="Stop_Click"
                    v:Ico.Of="{StaticResource I.Stop}" />
            <Button x:Name="GoRunBtn" Style="{StaticResource BtnSm}" Content="去启动" Click="GoLaunch_Click"
                    v:Ico.Of="{StaticResource I.Play}" Visibility="Collapsed" />
            <Button Style="{StaticResource BtnSm}" Content="日志" Margin="6,0,0,0"
                    Click="Logs_Click" v:Ico.Of="{StaticResource I.Log}" />
            <Button Style="{StaticResource BtnSm}" Content="$DSH_HOME" Margin="6,0,0,0"
                    Click="OpenHome_Click" v:Ico.Of="{StaticResource I.Folder}" />
            <Button Style="{StaticResource BtnSm}" Content="工作区" Margin="6,0,0,0"
                    Click="OpenWorkspace_Click" v:Ico.Of="{StaticResource I.Folder}" />
            <ContentControl x:Name="ProbeSpinner" Style="{StaticResource Spinner}"
                            Margin="12,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <Button Style="{StaticResource IcoBtn}" Click="Probe_Click"
                    ToolTip="再连一次管理口">
              <v:Ico Glyph="{StaticResource I.Refresh}" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="25" VerticalScrollBarVisibility="Auto">
        <Grid>
          <Border Style="{StaticResource Slab}" Padding="25,22,25,25" MaxWidth="380"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                  Visibility="{Binding NeedsSetup, Converter={StaticResource B2V}}">
            <StackPanel>
              <ContentControl Style="{StaticResource PictLg}" v:Ico.Of="{StaticResource I.Data}"
                              HorizontalAlignment="Left" Margin="0,0,0,12" />
              <TextBlock Text="还没有实例" Style="{StaticResource SectionTitle}" />
              <Button Style="{StaticResource BtnWidePrimary}" Content="去启动"
                      HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="GoLaunch_Click"
                      v:Ico.Of="{StaticResource I.Play}" />
            </StackPanel>
          </Border>

          <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
          <StackPanel x:Name="BundleCard">
            <Grid Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <v:Ico Glyph="{StaticResource I.Mod}" Height="11" Margin="0,1,6,0"
                       Foreground="{StaticResource TextMuted}" />
                <TextBlock Text="组合包" Style="{StaticResource Label}" VerticalAlignment="Center" />
              </StackPanel>
              <ComboBox x:Name="BundleProfile" Width="160" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        SelectionChanged="BundleProfile_Changed" />
            </Grid>

            <TextBlock x:Name="BundleEmpty" Style="{StaticResource Muted}" Margin="0,0,0,14"
                       Visibility="Collapsed" />

            <ItemsControl x:Name="BundleList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border local:Fx.Enter="row" Style="{StaticResource Row}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <Image Width="28" Height="28" Margin="0,0,8,0"
                                 Stretch="Uniform"
                                 Source="{Binding IconPath, Converter={StaticResource PathBmp}}"
                                 Visibility="{Binding HasIcon, Converter={StaticResource B2V}}" />
                          <ContentControl Style="{StaticResource Quant}" Margin="0,0,8,0"
                                          Content="{Binding Kind}"
                                          Visibility="{Binding HasIcon, Converter={StaticResource B2VNot}}" />
                          <TextBlock Style="{StaticResource Mono}"
                                     Foreground="{StaticResource TextPrimary}"
                                     Text="{Binding Spec}" ToolTip="{Binding Spec}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="14,6,0,0"
                                   FontSize="{StaticResource FsMicro}"
                                   Text="{Binding VersionText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSm}" Content="更新"
                                Click="BundleUpdate_Click" Tag="{Binding}"
                                ToolTip="dsh plugin --profile update"
                                v:Ico.Of="{StaticResource I.Refresh}" />
                        <Button Style="{StaticResource BtnDanger}" Height="26"
                                Padding="11,0" FontSize="{StaticResource FsSmall}"
                                Content="移除" Margin="8,0,0,0" Click="BundleRemove_Click"
                                Tag="{Binding}"
                                v:Ico.Of="{StaticResource I.Trash}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,12,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="BundleSpec" Tag="npm 包名或本地路径"
                       FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FsSmall}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="BundleAddBtn" Style="{StaticResource Btn}" Content="添加"
                        Click="BundleAdd_Click" v:Ico.Of="{StaticResource I.Plus}" />
                <Button x:Name="BundleUpdateAllBtn" Style="{StaticResource Btn}" Content="全部更新"
                        Margin="8,0,0,0" Click="BundleUpdateAll_Click"
                        ToolTip="对当前 --profile 的每一行 dsh plugin update"
                        v:Ico.Of="{StaticResource I.Refresh}" />
                <ContentControl x:Name="BundleSpinner" Style="{StaticResource Spinner}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Grid>
            <TextBox x:Name="BundleLog" Style="{StaticResource LogBox}" Height="0"
                     Visibility="Collapsed" Margin="0,0,0,22" />
          </StackPanel>

          <StackPanel x:Name="TreeCard">
            <Grid Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <v:Ico Glyph="{StaticResource I.Data}" Height="11" Margin="0,1,6,0"
                       Foreground="{StaticResource TextMuted}" />
                <TextBlock Text="正在聊的" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <ContentControl x:Name="TreeCount" Style="{StaticResource Quant}" Margin="16,0,0,0"
                                v:Ico.Of="{StaticResource I.Data}" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <TextBlock Text="只看在跑的" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Margin="0,0,9,0" />
                <CheckBox x:Name="OnlyLive" Style="{StaticResource Switch}" Click="Filter_Click"
                          ToolTip="只留下正在跑的" />
              </StackPanel>
            </Grid>

            <TextBlock x:Name="TreeHint" Style="{StaticResource Muted}" Margin="0,0,0,14"
                       MaxWidth="560" HorizontalAlignment="Left" />
            <TextBlock x:Name="KeyFault" Style="{StaticResource Muted}" Margin="0,0,0,14"
                       MaxWidth="560" HorizontalAlignment="Left" Foreground="{StaticResource Warning}"
                       Visibility="Collapsed" />

            <!-- Layout is known before the RPC answers, so the wait is a skeleton. -->
            <StackPanel x:Name="TreeSkeleton" Visibility="Collapsed">
              <Border Style="{StaticResource Skeleton}" Width="180" Height="14" Margin="0,0,0,10" />
              <Border Style="{StaticResource Skeleton}" Width="520" Height="34" Margin="0,0,0,7" />
              <Border Style="{StaticResource Skeleton}" Width="520" Height="34" Margin="0,0,0,7" />
              <Border Style="{StaticResource Skeleton}" Width="520" Height="34" />
            </StackPanel>

            <ItemsControl x:Name="Tree">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel local:Fx.Enter="card" Margin="0,0,0,18">
                    <Grid Margin="0,0,0,10">
                      <StackPanel Margin="0,0,140,0">
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="{StaticResource FsMicro}"
                                   Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"
                                   Text="{Binding Path}" ToolTip="{Binding Path}" />
                      </StackPanel>
                      <ContentControl Style="{StaticResource Quant}" Margin="0"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      v:Ico.Of="{StaticResource I.Data}"
                                      Content="{Binding Summary}" />
                    </Grid>

                    <!-- The indent rail is the tree: sessions belong to the workspace
                         above them, and the hairline says so without a disclosure toy. -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="1" Margin="6,2,15,6"
                              Background="{StaticResource LineBorder}" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border local:Fx.Enter="row" Style="{StaticResource Row}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                  <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Pip}"
                                            Background="{Binding Running, Converter={StaticResource PipColor}}" />
                                    <TextBlock Style="{StaticResource Mono}"
                                               Foreground="{StaticResource TextPrimary}"
                                               Text="{Binding SessionId, Converter={StaticResource Short}}"
                                               ToolTip="{Binding SessionId}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Margin="14,6,0,0">
                                    <ContentControl Style="{StaticResource Quant}"
                                                    v:Ico.Of="{StaticResource I.Tasks}"
                                                    Content="{Binding StatusText}" />
                                    <ContentControl Style="{StaticResource Quant}"
                                                    v:Ico.Of="{StaticResource I.Gear}"
                                                    Content="{Binding PresetText}" />
                                    <ContentControl Style="{StaticResource Quant}" Margin="0"
                                                    v:Ico.Of="{StaticResource I.Upload}"
                                                    Content="{Binding UpdatedText}" />
                                  </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                  <Button Style="{StaticResource BtnSm}" Content="打开"
                                          Click="OpenSession_Click" Tag="{Binding}"
                                          ToolTip="打开这条 session 的 transcript 文件"
                                          v:Ico.Of="{StaticResource I.Folder}" />
                                  <Button Style="{StaticResource BtnDanger}" Height="26"
                                          Padding="11,0" FontSize="{StaticResource FsSmall}"
                                          Content="取消" Margin="8,0,0,0" Click="Cancel_Click"
                                          Tag="{Binding}"
                                          v:Ico.Of="{StaticResource I.Stop}"
                                          Visibility="{Binding Running, Converter={StaticResource B2V}}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
