<UserControl x:Class="Pad.Views.WorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Pad.Views"
             Background="{StaticResource BgPage}">

  <UserControl.Resources>
    <!-- 轻柔弥散阴影：不靠描边分卡，靠投影分卡 -->
    <DropShadowEffect x:Key="WbShadow" BlurRadius="28" ShadowDepth="7" Direction="270"
                      Opacity="0.10" Color="#20303F" />

    <Style x:Key="WbCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgCard}" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Effect" Value="{StaticResource WbShadow}" />
      <Setter Property="Padding" Value="24,20,24,20" />
    </Style>

    <Style x:Key="WbSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="WbLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="WbValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="WbMuted" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
  </UserControl.Resources>

  <!-- 管理首页：可收起的项目侧栏 + 可自排的卡片区。 -->
  <Grid>
    <!-- ============ 卡片区（项目侧栏在舞台层：MainWindow 持有，换页不换侧栏） ============ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,20,26,28">
        <DockPanel LastChildFill="False" Margin="2,0,0,18">
          <TextBlock DockPanel.Dock="Left" Text="本机" Style="{StaticResource WbSection}"
                     VerticalAlignment="Center" />
          <Button x:Name="AddBtn" DockPanel.Dock="Right" Content="+ 卡片"
                  Style="{StaticResource BtnPrimary}" Height="32" Padding="16,0"
                  Click="Add_Click" />
          <Button x:Name="EditBtn" DockPanel.Dock="Right" Content="编辑"
                  Style="{StaticResource BtnSm}" Height="32" Padding="14,0"
                  Click="Edit_Click" Margin="0,0,10,0" />
          <Button x:Name="BundlesBtn" DockPanel.Dock="Right" Content="实例与组合包"
                  Style="{StaticResource BtnGhost}" Height="32" Padding="14,0"
                  Click="OpenBundles_Click" Margin="0,0,10,0" />
          <Button x:Name="RelationsBtn" DockPanel.Dock="Right" Content="关系"
                  Style="{StaticResource BtnGhost}" Height="32" Padding="14,0"
                  Click="OpenRelations_Click" Margin="0,0,10,0" />
        </DockPanel>

        <WrapPanel x:Name="CardHost" Orientation="Horizontal" />

        <TextBlock x:Name="Footnote" Style="{StaticResource WbMuted}" Margin="2,10,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- 添加卡片 -->
    <Popup x:Name="AddPop" Placement="Bottom" PlacementTarget="{Binding ElementName=AddBtn}"
           StaysOpen="False" AllowsTransparency="True">
      <Border Background="{StaticResource BgCard}" CornerRadius="16" Padding="8" Margin="0,8,0,0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.14" Color="#20303F" />
        </Border.Effect>
        <StackPanel x:Name="AddMenu" Width="196" />
      </Border>
    </Popup>
  </Grid>
</UserControl>
